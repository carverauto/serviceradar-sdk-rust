          "want_header": ""
        },
        {
          "action": "query",
          "url": "http://app.example.com/app/dashboard",
          "want_header": ""
        },
        {
          "action": "query",
          "url": "https://evil-example.com/app/dashboard",
          "want_header": ""
        }
      ]
    },
    {
      "name": "max_age_precedence_expires_and_cross_domain_reject",
      "steps": [
        {
          "action": "store",
          "url": "https://app.example.com/login",
          "set_cookies": [
            "session=old-secret; Path=/; Expires=Wed, 21 Oct 2026 07:28:00 GMT",
            "pref=dark; Path=/; Expires=Thu, 01 Jan 1970 00:00:00 GMT; Max-Age=3600",
            "rfc850=v1; Path=/; Expires=Sunday, 06-Nov-33 08:49:37 GMT",
            "cross=bad; Domain=other.com; Path=/",
            "tld=bad; Domain=com; Path=/",
            "expired=gone; Path=/; Expires=Wed, 01 Jan 2020 00:00:00 GMT"
          ]
        },
        {
          "action": "query",
          "url": "https://app.example.com/home",
          "want_header": "session=old-secret; pref=dark; rfc850=v1"
        },
        {
          "action": "store",
          "url": "https://app.example.com/logout",
          "set_cookies": [
            "session=ignored; Path=/; Expires=Wed, 21 Oct 2026 07:28:00 GMT; Max-Age=0"
          ]
        },
        {
          "action": "query",
          "url": "https://app.example.com/home",
          "want_header": "pref=dark; rfc850=v1"
        }
      ]
    },
    {
