        {
          "action": "store",
          "url": "https://sso.example.com/login",
          "set_cookies": [
            "double_dot=evil; Domain=..example.com; Path=/"
          ]
        },
        {
          "action": "query",
          "url": "https://sso.example.com/check",
          "want_header": ""
        },
        {
          "action": "query",
          "url": "https://app.example.com/check",
          "want_header": ""
        },
        {
          "action": "store",
          "url": "https://[::1]/login",
          "set_cookies": [
            "v6_host=v1; Path=/",
            "v6_dom=v2; Domain=::1; Path=/",
            "v6_brack=v3; Domain=[::1]; Path=/"
          ]
        },
        {
          "action": "query",
          "url": "https://[::1]/check",
          "want_header": "v6_host=v1; v6_dom=v2"
        }
      ]
    }
