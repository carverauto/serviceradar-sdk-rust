        {
          "action": "query",
          "url": "https://sso.example.com/auth/step2",
          "want_header": "sid=secret-sid-1"
        },
        {
          "action": "query",
          "url": "https://app.example.com/app/dashboard",
          "want_header": "shared=secret-shared-2"
        },
        {
          "action": "query",
          "url": "https://app.example.com/app",
          "want_header": "shared=secret-shared-2"
